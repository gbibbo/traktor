#!/bin/bash
#SBATCH --job-name=validate_mert_backend
#SBATCH --partition=a100
#SBATCH --gpus=1
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G
#SBATCH --time=00:15:00
#SBATCH --output=/mnt/fast/nobackup/users/gb0048/traktor/logs/validate_mert_backend_%j.out
#SBATCH --error=/mnt/fast/nobackup/users/gb0048/traktor/logs/validate_mert_backend_%j.err

# =============================================================================
# D2.2b — Validate MERT backend inside pytorch_2.7.0_cu128.sif on a100
# Confirms: SIF loads, transformers imports, MERT-v1-330M loads, 1 forward pass.
# Submit via: ./slurm/tools/on_submit.sh sbatch slurm/jobs/dj_clustering/validate_mert_backend.job
# =============================================================================

set -euo pipefail

REPO="/mnt/fast/nobackup/users/gb0048/traktor"
SCR="/mnt/fast/nobackup/scratch4weeks/gb0048"
SIF="$SCR/apptainer/pytorch_2.7.0_cu128.sif"
VENV="$SCR/venvs/traktor_mert_validate"
HF_HOME="$SCR/cache/huggingface"
PIP_CACHE_DIR="$SCR/cache/pip"

mkdir -p "$SCR/venvs" "$HF_HOME" "$PIP_CACHE_DIR" "$REPO/logs"

echo "[INFO] hostname: $(hostname)"
echo "[INFO] SIF: $SIF"
echo "[INFO] VENV: $VENV"
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader 2>/dev/null || echo "[WARN] nvidia-smi unavailable"

if [ ! -f "$SIF" ]; then
    echo "[ERROR] SIF not found: $SIF"
    echo "[ERROR] Run pull_pytorch_sif.job first"
    exit 1
fi

APRUN="apptainer exec --nv --cleanenv \
    --bind $REPO:$REPO \
    --bind $SCR:$SCR \
    --env PYTHONNOUSERSITE=1 \
    --env PYTHONPATH=$REPO \
    --env HF_HOME=$HF_HOME \
    --env TRANSFORMERS_CACHE=$HF_HOME \
    --env PIP_CACHE_DIR=$PIP_CACHE_DIR \
    $SIF"

echo "[INFO] Creating validation venv with system site packages..."
$APRUN python3 -s -m venv --system-site-packages "$VENV"

echo "[INFO] Upgrading pip..."
$APRUN "$VENV/bin/python" -m pip install --upgrade pip

echo "[INFO] Installing validation dependencies..."
$APRUN "$VENV/bin/python" -m pip install --force-reinstall "transformers==4.44.2" pandas soundfile tqdm

echo "[INFO] Running import sanity check..."
$APRUN "$VENV/bin/python" -s - <<'PY'
import sys
import torch
import transformers
from transformers import AutoModel, Wav2Vec2FeatureExtractor

print("[INFO] python:", sys.version)
print("[INFO] torch:", torch.__version__)
print("[INFO] cuda_available:", torch.cuda.is_available())
print("[INFO] transformers:", transformers.__version__)
print("[INFO] transformers_file:", transformers.__file__)
print("[INFO] AutoModel available:", AutoModel is not None)
print("[INFO] Wav2Vec2FeatureExtractor available:", Wav2Vec2FeatureExtractor is not None)
PY

echo "[INFO] Running MERT backend validation..."
$APRUN "$VENV/bin/python" -s "$REPO/scripts/dj_clustering/validate_mert_backend.py"

echo "[INFO] DONE: $(date)"
